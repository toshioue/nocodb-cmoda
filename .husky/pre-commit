#!/usr/bin/env sh

# Common git dir (shared across worktrees). Don't use --path-format=absolute;
# it's Git 2.31+ only. Normalize manually instead.
common_git_dir=$(git rev-parse --git-common-dir)

case $common_git_dir in
  /*) ;;                               # already absolute
  *)  common_git_dir=$PWD/$common_git_dir ;;
esac

# 1) Respect core.worktree if set (gitdir redirection layouts)
main_root=$(git --git-dir="$common_git_dir" config --path --get core.worktree 2>/dev/null || true)

# 2) Fallback: conventional <main>/.git layout
if [ -z "$main_root" ]; then
  main_root=$(CDPATH= cd -- "$common_git_dir/.." && pwd -P)
fi

. "$main_root/.husky/_/husky.sh"

npx lint-staged